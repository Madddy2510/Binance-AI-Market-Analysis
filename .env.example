# Copy this to your S3 bucket as config/.env
# Get your free FRED API key: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional: Binance API (public endpoints work without keys)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Optional: HuggingFace token for LLaMA training phase
HF_TOKEN=your_hf_token_here
